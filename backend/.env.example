# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
CHAT_HISTORY_LIMIT=10
DAILY_CHAT_LIMIT=50
# 이미지 인식 (기본: OPENAI_MODEL과 같은 모델)
# OPENAI_VISION_MODEL=gpt-4o-mini
VISION_MAX_TOKENS=2500
DAILY_IMAGE_LIMIT=30

# Firebase (새 프로젝트의 서비스 계정 키): 둘 중 하나만 설정
# (Render) 서비스 계정 JSON 전체를 문자열로
FIREBASE_SERVICE_ACCOUNT_JSON=
# (로컬) 서비스 계정 키 파일 경로 — 이 파일은 절대 git에 올리지 말 것
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# firestore | memory  (memory: 테스트 전용. 실제 로그인 토큰 검증은 firestore 모드에서만 동작)
DB_BACKEND=firestore

# CORS 허용 도메인 (쉼표 구분) — 배포 후 Vercel 도메인 추가
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
