rules_version = '2';
// 브라우저(클라이언트)에서 Firestore에 직접 접근하는 것을 모두 막는다.
// 이 서비스는 백엔드(FastAPI)만 Firebase Admin SDK로 DB에 접근하며, Admin SDK는 이 규칙의 영향을 받지 않는다.
// → 웹 설정(apiKey 등)이 알려져도 다른 사람이 DB를 읽거나 쓸 수 없다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
